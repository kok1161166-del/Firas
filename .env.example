# ============================================================
#  Firas AI — GROQ Keys
#  انسخ هذا الملف إلى اسم:  .env   (نفس المجلد)
#  ثم الصق مفاتيحك مكان CHANGE_ME
# ============================================================

# المفتاح الأول (الأساسي)
GROQ_API_KEY_1=CHANGE_ME_1

# المفتاح الثاني (احتياطي — يعمل تلقائياً إذا فشل الأول)
GROQ_API_KEY_2=CHANGE_ME_2

# المفتاح الثالث (احتياطي أخير)
GROQ_API_KEY_3=CHANGE_ME_3

# --- للتشغيل المحلي (npm run dev) فقط ---
# الفرونت يحتاج نسخة VITE_ عشان يجرب GROQ مباشرة إذا الباك-إند المحلي مو شغال.
# (في Vercel الحقيقي: المفاتيح تبقى بالسيرفر فقط وما تنكشف)
VITE_GROQ_API_KEYS=CHANGE_ME_1,CHANGE_ME_2,CHANGE_ME_3

# --- Citadel Runner score authority (server side, Vercel only) ---
# /api/runner-score proves a run is physically possible and signs it with
# HMAC. Set BOTH in Vercel; the endpoint degrades gracefully without them
# (scores are still validated + signed, they just are not persisted).
RUNNER_SIGNING_SECRET=CHANGE_ME_long_random_string
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_supabase_service_role_key

# ============================================================
#  FIRAS Gallery Wall — Supabase + ImageKit (3 accounts failover)
#  القاعدة الذهبية: كل ما هو PRIVATE_* / SECRET_* / SERVICE_* / PASSWORD
#  يبقى في السيرفر فقط (Vercel Env) ولا يبدأ بـ VITE_ أبداً.
#  نفّذ supabase-gallery.sql في Supabase SQL Editor أولاً.
# ============================================================

# Supabase (رابط المشروع — نفسه للسيرفر والمتصفح)
SUPABASE_URL=https://CHANGE_ME.supabase.co
VITE_SUPABASE_URL=https://CHANGE_ME.supabase.co

# المفتاح العلني (publishable/anon) — آمن للمتصفح (يبدأ بـ VITE_)
SUPABASE_ANON_KEY=CHANGE_ME_supabase_anon_or_publishable_key
VITE_SUPABASE_ANON_KEY=CHANGE_ME_supabase_anon_or_publishable_key

# مفتاح service_role — سرّي جداً (السيرفر فقط! لا تضعه في VITE_ أبداً)
SUPABASE_SECRET_KEY=CHANGE_ME_service_role_jwt
# (اسم بديل مدعوم: SUPABASE_SERVICE_ROLE_KEY)

# ImageKit — الحساب 1 (الأساسي: 20GB)
IMAGEKIT_1_ID=CHANGE_ME_1
IMAGEKIT_1_ENDPOINT=https://ik.imagekit.io/CHANGE_ME_1
IMAGEKIT_1_PUBLIC_KEY=CHANGE_ME_public_1
IMAGEKIT_1_PRIVATE_KEY=CHANGE_ME_private_1

# ImageKit — الحساب 2 (احتياطي تلقائي إذا فشل الأول)
IMAGEKIT_2_ID=CHANGE_ME_2
IMAGEKIT_2_ENDPOINT=https://ik.imagekit.io/CHANGE_ME_2
IMAGEKIT_2_PUBLIC_KEY=CHANGE_ME_public_2
IMAGEKIT_2_PRIVATE_KEY=CHANGE_ME_private_2

# ImageKit — الحساب 3 (احتياطي أخير)
IMAGEKIT_3_ID=CHANGE_ME_3
IMAGEKIT_3_ENDPOINT=https://ik.imagekit.io/CHANGE_ME_3
IMAGEKIT_3_PUBLIC_KEY=CHANGE_ME_public_3
IMAGEKIT_3_PRIVATE_KEY=CHANGE_ME_private_3

# إدارة المعرض — كلمة سر قوية + سر توقيع التوكن (السيرفر فقط!)
GALLERY_ADMIN_PASSWORD=CHANGE_ME_strong_long_password
GALLERY_ADMIN_SECRET=CHANGE_ME_long_random_string_for_token_signing
