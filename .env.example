# ============================================================
#  Firas AI — GROQ Keys
#  انسخ هذا الملف إلى اسم:  .env   (نفس المجلد)
#  ثم الصق مفاتيحك مكان CHANGE_ME
# ============================================================

# المفتاح الأول (الأساسي)
GROQ_API_KEY_1=CHANGE_ME_1

# المفتاح الثاني (احتياطي — يعمل تلقائياً إذا فشل الأول)
GROQ_API_KEY_2=CHANGE_ME_2

# المفتاح الثالث (احتياطي أخير)
GROQ_API_KEY_3=CHANGE_ME_3

# --- للتشغيل المحلي (npm run dev) فقط ---
# الفرونت يحتاج نسخة VITE_ عشان يجرب GROQ مباشرة إذا الباك-إند المحلي مو شغال.
# (في Vercel الحقيقي: المفاتيح تبقى بالسيرفر فقط وما تنكشف)
VITE_GROQ_API_KEYS=CHANGE_ME_1,CHANGE_ME_2,CHANGE_ME_3

# --- Citadel Runner score authority (server side, Vercel only) ---
# /api/runner-score proves a run is physically possible and signs it with
# HMAC. Set BOTH in Vercel; the endpoint degrades gracefully without them
# (scores are still validated + signed, they just are not persisted).
RUNNER_SIGNING_SECRET=CHANGE_ME_long_random_string
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_supabase_service_role_key
